{
  "title": "Spring Boot Monitoring",
  "schemaVersion": 38,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate({app=\"spring-prototype\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors",
      "type": "timeseries",
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate({app=\"spring-prototype\",level=\"ERROR\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application Logs",
      "type": "logs",
      "datasource": "Loki",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "{app=\"spring-prototype\"}",
          "refId": "A"
        }
      ]
    }
  ]
}